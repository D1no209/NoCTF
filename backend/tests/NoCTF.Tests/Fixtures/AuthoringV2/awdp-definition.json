{
  "patchEntrypoint": "fix.sh",
  "patchCommand": [
    "/bin/sh",
    "{entrypoint}"
  ],
  "patchTimeoutSeconds": 60,
  "checker": {
    "image": "noctf-awdp-v2-checker:local",
    "command": [],
    "environment": {},
    "timeoutSeconds": 120
  },
  "readyTimeoutSeconds": 30,
  "maximumPatchUploadBytes": 268435456,
  "checkerFixInput": true,
  "mode": "Awdp",
  "awdp": {},
  "runtime": {
    "kind": "Container",
    "allocation": "PerTeam",
    "flagSource": "PerTeam",
    "egressPolicy": "Isolated",
    "container": {
      "services": [
        {
          "name": "main",
          "image": "noctf-awdp-v2-target:local",
          "cpuCores": 0.5,
          "memoryMiB": 512,
          "internalPorts": [
            8080
          ],
          "flagEnvironmentVariableName": "FLAG"
        }
      ]
    },
    "ttlSeconds": 3600,
    "operationTimeoutSeconds": 60,
    "urlBindings": [
      {
        "serviceName": "main",
        "containerPort": 8080,
        "urlTemplate": "http://{HOST}:{PORT}",
        "exposure": "OwnerOnly",
        "isControlCheck": false
      }
    ]
  }
}
