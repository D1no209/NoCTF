{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://noctf.example/schemas/webhooks/competition-events-v1.schema.json",
  "title": "NoCTF competition webhook event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "specversion",
    "id",
    "source",
    "type",
    "subject",
    "time",
    "datacontenttype",
    "dataschema",
    "data"
  ],
  "properties": {
    "specversion": { "const": "1.0" },
    "id": { "type": "string", "format": "uuid" },
    "source": { "type": "string", "format": "uri" },
    "type": {
      "enum": [
        "com.noctf.competition.lifecycle.changed.v1",
        "com.noctf.competition.challenge.published.v1",
        "com.noctf.competition.challenge.updated.v1",
        "com.noctf.competition.hint.published.v1",
        "com.noctf.competition.announcement.published.v1",
        "com.noctf.competition.team.banned.v1",
        "com.noctf.competition.team.ban.corrected.v1",
        "com.noctf.competition.blood.awarded.v1",
        "com.noctf.competition.awdp.break.resolved.v1",
        "com.noctf.competition.awdp.fix.resolved.v1",
        "com.noctf.webhook.test.v1"
      ]
    },
    "subject": { "type": "string", "pattern": "^competitions/[0-9a-fA-F-]{36}$" },
    "time": { "type": "string", "format": "date-time" },
    "datacontenttype": { "const": "application/json" },
    "dataschema": { "type": "string", "format": "uri" },
    "data": { "$ref": "#/$defs/data" }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "type": { "const": "com.noctf.competition.blood.awarded.v1" }
        },
        "required": ["type"]
      },
      "then": {
        "properties": {
          "data": {
            "required": ["capturedAt", "eventSequence", "requiredProjectionVersion", "publicProjectionVersion", "competitionRevision", "event", "resources"],
            "properties": {
              "eventSequence": { "type": "integer", "minimum": 1 },
              "requiredProjectionVersion": { "type": "integer", "minimum": 0 },
              "publicProjectionVersion": { "type": "integer", "minimum": 0 },
              "competitionRevision": { "type": "string", "format": "uuid" },
              "event": {
                "required": ["competitionId", "teamId", "competitionChallengeId", "award"],
                "properties": {
                  "teamId": { "type": "string", "format": "uuid" },
                  "competitionChallengeId": { "type": "string", "format": "uuid" },
                  "award": { "enum": ["First", "Second", "Third"] }
                }
              },
              "resources": {
                "required": ["competition", "challenge", "leaderboard"],
                "properties": {
                  "challenge": {
                    "type": "object",
                    "required": ["id"],
                    "properties": {
                      "id": { "type": "string", "format": "uuid" },
                      "dataScope": { "enum": ["Live", "Frozen"] },
                      "projectionVersion": { "type": "string", "pattern": "^[0-9]+$" }
                    },
                    "allOf": [
                      {
                        "if": {
                          "properties": { "dataScope": { "enum": ["Live", "Frozen"] } },
                          "required": ["dataScope"]
                        },
                        "then": { "required": ["title", "projectionVersion"] }
                      }
                    ]
                  },
                  "leaderboard": {
                    "type": "object",
                    "required": ["dataScope", "teams", "projectionVersion"],
                    "properties": {
                      "dataScope": { "enum": ["Live", "Frozen"] },
                      "teams": { "type": "array" },
                      "projectionVersion": { "type": "string", "pattern": "^[0-9]+$" }
                    },
                    "allOf": [
                      {
                        "if": {
                          "properties": { "dataScope": { "const": "Frozen" } },
                          "required": ["dataScope"]
                        },
                        "then": { "required": ["dataAsOf"] }
                      }
                    ]
                  }
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capturedAt", "event", "resources"],
      "properties": {
        "capturedAt": { "type": "string", "format": "date-time" },
        "eventSequence": { "type": ["integer", "null"], "minimum": 1 },
        "requiredProjectionVersion": { "type": ["integer", "null"], "minimum": 0 },
        "publicProjectionVersion": { "type": ["integer", "null"], "minimum": 0 },
        "competitionRevision": { "type": ["string", "null"], "format": "uuid" },
        "event": {
          "type": "object",
          "required": ["competitionId"],
          "properties": {
            "competitionId": { "type": "string", "format": "uuid" },
            "competitionChallengeId": { "type": ["string", "null"], "format": "uuid" },
            "hintId": { "type": ["string", "null"], "format": "uuid" },
            "notificationId": { "type": ["string", "null"], "format": "uuid" },
            "teamId": { "type": ["string", "null"], "format": "uuid" },
            "gameplayFactId": { "type": ["string", "null"], "format": "uuid" },
            "from": { "type": ["string", "null"] },
            "to": { "type": ["string", "null"] },
            "award": { "type": ["string", "null"] },
            "outcome": { "type": ["string", "null"] }
          }
        },
        "resources": {
          "type": "object",
          "required": ["competition"],
          "properties": {
            "competition": { "type": "object" },
            "challenge": { "type": ["object", "null"] },
            "announcement": { "type": ["object", "null"] },
            "leaderboard": { "type": ["object", "null"] }
          }
        }
      }
    }
  }
}
