<Project>
  <PropertyGroup Condition="'$(OutputType)' == 'Exe'">
    <NoCtfRuntimeSourceRevision Condition="'$(NoCtfRuntimeFlavor)' == 'Official'">official-$(NoCtfManagedRuntimeVersion)</NoCtfRuntimeSourceRevision>
    <NoCtfRuntimeSourceRevision Condition="'$(NoCtfRuntimeFlavor)' == 'Satori'">07c917bdeea06c8eecd1a65a28e171c72713cdfb</NoCtfRuntimeSourceRevision>
    <PublishReadyToRun Condition="'$(NoCtfRuntimeFlavor)' == 'Satori'">false</PublishReadyToRun>
    <PublishTrimmed Condition="'$(NoCtfRuntimeFlavor)' == 'Satori'">false</PublishTrimmed>
    <UseAppHost Condition="'$(NoCtfRuntimeFlavor)' == 'Satori'">true</UseAppHost>
  </PropertyGroup>
  <ItemGroup Condition="'$(OutputType)' == 'Exe'">
    <AssemblyMetadata Include="NoCtfRuntimeFlavor" Value="$(NoCtfRuntimeFlavor)" />
    <AssemblyMetadata Include="NoCtfRuntimeSourceRevision" Value="$(NoCtfRuntimeSourceRevision)" />
    <AssemblyMetadata Include="NoCtfRuntimeIdentifier" Value="$(RuntimeIdentifier)" />
    <FrameworkReference Update="Microsoft.AspNetCore.App" RuntimeFrameworkVersion="$(NoCtfAspNetCoreRuntimeVersion)" />
  </ItemGroup>
  <ItemGroup Condition="'$(NoCtfRuntimeFlavor)' == 'Satori'">
    <FrameworkReference Update="Microsoft.NETCore.App" RuntimeFrameworkVersion="$(NoCtfSatoriPackageVersion)" />
    <KnownAppHostPack Update="Microsoft.NETCore.App" AppHostPackVersion="$(NoCtfSatoriPackageVersion)" />
  </ItemGroup>
  <Target Name="ValidateNoCtfManagedRuntime" BeforeTargets="PrepareForBuild;CollectPackageReferences;Publish">
    <Error Condition="'$(NoCtfRuntimeFlavor)' != 'Official' and '$(NoCtfRuntimeFlavor)' != 'Satori'" Text="NoCtfRuntimeFlavor must be Official or Satori." />
    <Error Condition="'$(OutputType)' == 'Exe' and '$(NoCtfRuntimeFlavor)' == 'Satori' and '$(RuntimeIdentifier)' != 'linux-x64' and '$(RuntimeIdentifier)' != 'win-x64'" Text="Satori requires RuntimeIdentifier=linux-x64 or win-x64." />
    <Error Condition="'$(OutputType)' == 'Exe' and '$(NoCtfRuntimeFlavor)' == 'Satori' and '$(SelfContained)' != 'true'" Text="Satori must be published self-contained; use backend/runtime/runtime.py publish." />
    <Error Condition="'$(OutputType)' == 'Exe' and '$(NoCtfRuntimeFlavor)' == 'Satori' and ('$(NoCtfSatoriPackageVersion)' == '' or '$(NoCtfSatoriVerifiedManifest)' == '' or !Exists('$(NoCtfSatoriVerifiedManifest)'))" Text="A verified, commit-scoped Satori package manifest is required. Use backend/runtime/runtime.py publish." />
    <Error Condition="'$(OutputType)' == 'Exe' and '$(NoCtfRuntimeFlavor)' == 'Satori' and '$(PublishAot)' == 'true'" Text="NativeAOT is not part of the validated Satori publishing contract." />
    <Exec Condition="'$(OutputType)' == 'Exe' and '$(NoCtfRuntimeFlavor)' == 'Satori'"
          Command="&quot;$(NoCtfRuntimePython)&quot; &quot;$(MSBuildThisFileDirectory)runtime.py&quot; verify --runtime-dir &quot;$([System.IO.Path]::GetDirectoryName('$(NoCtfSatoriVerifiedManifest)'))&quot; --rid &quot;$(RuntimeIdentifier)&quot;" />
  </Target>
  <Target Name="VerifyPublishedSatoriRuntime" AfterTargets="Publish" Condition="'$(OutputType)' == 'Exe' and '$(NoCtfRuntimeFlavor)' == 'Satori'">
    <Exec Command="&quot;$(NoCtfRuntimePython)&quot; &quot;$(MSBuildThisFileDirectory)runtime.py&quot; verify-published --runtime-dir &quot;$([System.IO.Path]::GetDirectoryName('$(NoCtfSatoriVerifiedManifest)'))&quot; --directory &quot;$(PublishDir).&quot; --rid &quot;$(RuntimeIdentifier)&quot;" />
  </Target>
</Project>
