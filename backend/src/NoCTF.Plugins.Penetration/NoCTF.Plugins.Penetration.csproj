<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../NoCTF.PluginBase/NoCTF.PluginBase.csproj" />
    <ProjectReference Include="../NoCTF.Core/NoCTF.Core.csproj" />
    <ProjectReference Include="../NoCTF.Application/NoCTF.Application.csproj" />
    <ProjectReference Include="../NoCTF.Infrastructure/NoCTF.Infrastructure.csproj" />
  </ItemGroup>

  <Target Name="CopyToApiPluginOutput" AfterTargets="Build">
    <MakeDir Directories="../NoCTF.API/bin/$(Configuration)/$(TargetFramework)/plugins" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="../NoCTF.API/bin/$(Configuration)/$(TargetFramework)/plugins" SkipUnchangedFiles="true" />
  </Target>

</Project>
