    "@tanstack/vue-table": "^9.2.4",
    "@vue-flow/core": "1.48.2",
    "@vueuse/core": "^14.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "echarts": "^6.1.0",
    "elkjs": "^0.12.0",
