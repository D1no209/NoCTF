<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <SpaRoot>ClientApp\</SpaRoot>
    <SpaProxyServerUrl>http://127.0.0.1:3000</SpaProxyServerUrl>
    <SpaProxyLaunchCommand>npm start</SpaProxyLaunchCommand>
    <BuildSpaOnPublish Condition="'$(BuildSpaOnPublish)' == ''">true</BuildSpaOnPublish>
    <DefaultItemExcludes>
      $(DefaultItemExcludes);$(SpaRoot)node_modules\**;$(SpaRoot).nuxt\**;$(SpaRoot).output\**
    </DefaultItemExcludes>
    <NoWarn>$(NoWarn);NU1608</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../NoCTF.Application/NoCTF.Application.csproj" />
    <ProjectReference Include="../NoCTF.GameModes/NoCTF.GameModes.csproj" />
    <ProjectReference Include="../NoCTF.Infrastructure/NoCTF.Infrastructure.csproj" />
    <ProjectReference Include="../NoCTF.Hosting/NoCTF.Hosting.csproj" />
    <ProjectReference Include="../NoCTF.Worker/NoCTF.Worker.csproj" />
    <ProjectReference Include="../NoCTF.Runner/NoCTF.Runner.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="FastEndpoints" />
    <PackageReference Include="FastEndpoints.Security" />
    <PackageReference Include="FastEndpoints.Swagger" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.StackExchangeRedis" />
    <PackageReference Include="Microsoft.AspNetCore.SpaProxy" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
    <PackageReference Include="Riok.Mapperly" PrivateAssets="all" />
    <PackageReference Include="WolverineFx" />
    <PackageReference Include="WolverineFx.RuntimeCompilation" />
  </ItemGroup>
  <ItemGroup>
    <Content Remove="$(SpaRoot)**" />
    <None Remove="$(SpaRoot)**" />
    <None Include="$(SpaRoot)**"
          Exclude="$(SpaRoot)node_modules\**;$(SpaRoot).nuxt\**;$(SpaRoot).output\**" />
  </ItemGroup>
  <Target Name="DebugEnsureNodeEnv"
          BeforeTargets="Build"
          Condition="'$(Configuration)' == 'Debug' And !Exists('$(SpaRoot)node_modules')">
    <Exec Command="node --version" ContinueOnError="true">
      <Output TaskParameter="ExitCode" PropertyName="NodeErrorCode" />
    </Exec>
    <Error Condition="'$(NodeErrorCode)' != '0'"
           Text="Node.js is required to build and run the ClientApp. Install Node.js and restart your command prompt or IDE." />
    <Message Importance="high" Text="Restoring ClientApp dependencies using npm..." />
    <Exec WorkingDirectory="$(SpaRoot)" Command="npm install --no-package-lock" />
  </Target>
  <Target Name="PublishRunNuxt"
          AfterTargets="ComputeFilesToPublish"
          Condition="'$(BuildSpaOnPublish)' == 'true'">
    <Exec WorkingDirectory="$(SpaRoot)" Command="bun install --frozen-lockfile" />
    <Exec WorkingDirectory="$(SpaRoot)" Command="bun run generate" />
    <ItemGroup>
      <ClientAppFiles Include="$(SpaRoot).output\public\**" />
      <ResolvedFileToPublish Include="@(ClientAppFiles->'%(FullPath)')"
                             Exclude="@(ResolvedFileToPublish)">
        <RelativePath>wwwroot\%(RecursiveDir)%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
</Project>
