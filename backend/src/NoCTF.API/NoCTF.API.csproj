<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <SpaRoot>..\..\..\frontend\</SpaRoot>
    <SpaProxyServerUrl>http://localhost:5173</SpaProxyServerUrl>
    <SpaProxyLaunchCommand>bun run dev</SpaProxyLaunchCommand>
    <BuildSpaOnPublish Condition="'$(BuildSpaOnPublish)' == ''">true</BuildSpaOnPublish>
  </PropertyGroup>

  <Target Name="BuildSpaForPublish" AfterTargets="Publish" Condition="'$(BuildSpaOnPublish)' == 'true'">
    <Exec WorkingDirectory="$(SpaRoot)" Command="bun install --frozen-lockfile" />
    <Exec WorkingDirectory="$(SpaRoot)" Command="bun run build" />
    <ItemGroup>
      <SpaDistFiles Include="$(SpaRoot)dist\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(SpaDistFiles)" DestinationFiles="@(SpaDistFiles->'$(PublishDir)wwwroot\%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>

  <ItemGroup>
    <ProjectReference Include="../NoCTF.Application/NoCTF.Application.csproj" />
    <ProjectReference Include="../NoCTF.Core/NoCTF.Core.csproj" />
    <ProjectReference Include="../NoCTF.Infrastructure/NoCTF.Infrastructure.csproj" />
    <ProjectReference Include="../NoCTF.PluginBase/NoCTF.PluginBase.csproj" />
    <ProjectReference Include="../NoCTF.Container.Docker/NoCTF.Container.Docker.csproj" />
    <ProjectReference Include="../NoCTF.Container.K8s/NoCTF.Container.K8s.csproj" />
    <ProjectReference Include="../NoCTF.Runner.Client/NoCTF.Runner.Client.csproj" />
  </ItemGroup>

  <Target Name="CopyPlugins" AfterTargets="Build">
    <MakeDir Directories="$(TargetDir)plugins" />
    <ItemGroup>
      <PluginDlls Include="$(SolutionDir)src/NoCTF.Plugins.CTF/bin/$(Configuration)/$(TargetFramework)/NoCTF.Plugins.CTF.dll" Condition="Exists('$(SolutionDir)src/NoCTF.Plugins.CTF/bin/$(Configuration)/$(TargetFramework)/NoCTF.Plugins.CTF.dll')" />
      <PluginDlls Include="$(SolutionDir)src/NoCTF.Plugins.AWD/bin/$(Configuration)/$(TargetFramework)/NoCTF.Plugins.AWD.dll" Condition="Exists('$(SolutionDir)src/NoCTF.Plugins.AWD/bin/$(Configuration)/$(TargetFramework)/NoCTF.Plugins.AWD.dll')" />
      <PluginDlls Include="$(SolutionDir)src/NoCTF.Plugins.AWDP/bin/$(Configuration)/$(TargetFramework)/NoCTF.Plugins.AWDP.dll" Condition="Exists('$(SolutionDir)src/NoCTF.Plugins.AWDP/bin/$(Configuration)/$(TargetFramework)/NoCTF.Plugins.AWDP.dll')" />
      <PluginDlls Include="$(SolutionDir)src/NoCTF.Plugins.KoH/bin/$(Configuration)/$(TargetFramework)/NoCTF.Plugins.KoH.dll" Condition="Exists('$(SolutionDir)src/NoCTF.Plugins.KoH/bin/$(Configuration)/$(TargetFramework)/NoCTF.Plugins.KoH.dll')" />
      <PluginDlls Include="$(SolutionDir)src/NoCTF.Plugins.Penetration/bin/$(Configuration)/$(TargetFramework)/NoCTF.Plugins.Penetration.dll" Condition="Exists('$(SolutionDir)src/NoCTF.Plugins.Penetration/bin/$(Configuration)/$(TargetFramework)/NoCTF.Plugins.Penetration.dll')" />
    </ItemGroup>
    <Copy SourceFiles="@(PluginDlls)" DestinationFolder="$(TargetDir)plugins/" SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup>
    <PackageReference Include="FastEndpoints" Version="5.33.0" />
    <PackageReference Include="FastEndpoints.Security" Version="5.33.0" />
    <PackageReference Include="FastEndpoints.Swagger" Version="5.33.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.StackExchangeRedis" Version="8.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.SpaProxy" Version="8.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.SpaServices.Extensions" Version="8.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.11">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

</Project>
