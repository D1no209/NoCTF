{
  "BackgroundQueue": {
    "ProcessingCapacity": 256,
    "ProcessingConcurrency": 4,
    "ProjectionCapacity": 64,
    "ProjectionConcurrency": 1,
    "MaintenanceCapacity": 16,
    "MaintenanceConcurrency": 1,
    "ShutdownDrainSeconds": 20
  },
  "Worker": {
    "Queues": ["control", "gameplay", "projection", "background"],
    "Concurrency": {
      "Control": 2,
      "Gameplay": 8,
      "Projection": 2,
      "Background": 2
    }
  },
  "CompetitionLifecycle": {
    "IntervalSeconds": 5
  },
  "Runtime": {
    "OrphanCleanupIntervalSeconds": 60
  },
  "SystemProducers": {
    "KohSweepSeconds": 1
  },
  "Caching": {
    "ReadModelsTtlSeconds": 60,
    "LocalComputationTtlMinutes": 30
  },
  "Uploads": {
    "MaximumAvatarBytes": 12582912,
    "MaximumLogoBytes": 12582912,
    "MaximumPosterBytes": 12582912,
    "MaximumAttachmentBytes": 1073741824
  },
  "Storage": {
    "Provider": "Local",
    "LocalRoot": "storage"
  },
  "ConnectionStrings": {
    "PostgreSql": "Host=localhost;Port=5432;Database=noctf;Username=postgres;Password=postgres",
    "Redis": "localhost:6379",
    "Nats": "nats://localhost:4222"
  },
  "Wolverine": {
    "Nats": {
      "AckWaitSeconds": 30,
      "MaxDeliver": 5,
      "DuplicateWindowSeconds": 120
    }
  },
  "Observability": {
    "Monitoring": {
      "SustainedWindowMinutes": 3,
      "PendingWarning": 25,
      "PendingCritical": 100,
      "AckPendingWarning": 10,
      "AckPendingCritical": 50,
      "RedeliveryWarning": 1,
      "RedeliveryCritical": 10,
      "OutboxWarning": 25,
      "OutboxCritical": 100,
      "InboxWarning": 25,
      "InboxCritical": 100,
      "JetStreamStorageWarningPercent": 75,
      "JetStreamStorageCriticalPercent": 90
    }
  },
  "Authentication": {
    "SigningKey": "development-only-change-this-signing-key-to-a-long-random-value",
    "Issuer": "NoCTF",
    "Audience": "NoCTF.Api",
    "ClockSkewSeconds": 30,
    "RefreshAllowedOrigins": [],
    "AccessTokenMinutes": 15,
    "RefreshCookieSecure": true
  },
  "HumanVerification": {
    "Provider": "None",
    "Monitoring": {
      "PublicOrigin": "",
      "IntervalSeconds": 60,
      "StageTimeoutSeconds": 3
    },
    "Cap": {
      "ServerUrl": "",
      "BackendServerUrl": "",
      "SiteKey": "",
      "Secret": ""
    },
    "Turnstile": {
      "SiteKey": "",
      "Secret": "",
      "AllowedHostnames": []
    }
  },
  "RequestAdmission": {
    "AuthenticationIpPerMinute": 600,
    "AuthenticationAccountPerMinute": 15,
    "PasswordConcurrency": 8,
    "SensitiveIpPerMinute": 1200,
    "RuntimeCommandPerUserPerMinute": 30,
    "PatchConcurrency": 2,
    "PatchPerUserConcurrency": 1,
    "SubmissionPerUserPerMinute": 30,
    "SubmissionConcurrency": 16,
    "SubmissionPerUserConcurrency": 2
  },
  "RunnerScoring": {
    "SigningKey": "development-only-runner-scoring-key-change-this-value-now",
    "Issuer": "NoCTF.Runner",
    "Audience": "NoCTF.ScoringInput",
    "LifetimeSeconds": 300
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
