{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "JwtSettings": {
    "Secret": "",
    "Issuer": "NoCTF",
    "Audience": "NoCTF",
    "ExpiryMinutes": 60,
    "MaxSessionMinutes": 1440
  },
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Database": {
    "AutoMigrate": false
  },
  "EmailVerification": {
    "Enabled": false,
    "PublicBaseUrl": "http://localhost:5173",
    "TokenLifetimeMinutes": 1440,
    "ResendCooldownSeconds": 60,
    "Smtp": {
      "Host": "",
      "Port": 587,
      "EnableSsl": true,
      "UserName": "",
      "Password": "",
      "FromAddress": "",
      "FromName": "NoCTF",
      "TimeoutSeconds": 10
    }
  },
  "ApiRequests": {
    "MaxRequestBodyBytes": 2097152
  },
  "CompetitionActions": {
    "MaxRequestBodyBytes": 65536
  },
  "Notifications": {
    "RedisStream": {
      "Key": "noctf:hub-notifications:v1",
      "DeadLetterKey": "noctf:hub-notifications:dead-letter:v1",
      "ConsumerGroup": "noctf-api-relays-v1",
      "MaxLength": 100000,
      "DeadLetterMaxLength": 10000,
      "BatchSize": 50,
      "MaxPayloadBytes": 65536,
      "BlockMilliseconds": 2000,
      "ClaimIdleSeconds": 30,
      "RecoveryIntervalSeconds": 30,
      "DeliveryMarkerTtlSeconds": 86400
    }
  },
  "SeedAdmin": {
    "Email": "admin@noctf.local",
    "UserName": "admin",
    "Password": ""
  },
  "StorageProvider": {
    "Type": "Local",
    "Local": {
      "BasePath": "uploads"
    },
    "S3": {
      "Endpoint": "http://localhost:9000",
      "Bucket": "noctf",
      "AccessKey": "",
      "SecretKey": "",
      "Region": "us-east-1"
    }
  }
}
