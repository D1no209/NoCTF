ASPNETCORE_HTTP_PORTS=8080
DOTNET_ENVIRONMENT=Production
Hosting__Roles__0=Api
Hosting__Roles__1=Worker
Hosting__Roles__2=Runner
ConnectionStrings__PostgreSql=Host=postgres;Port=5432;Database=${POSTGRES_DB:-noctf};Username=${POSTGRES_USER:-noctf};Password=${POSTGRES_PASSWORD:?Set POSTGRES_PASSWORD}
ConnectionStrings__Redis=redis:6379
ConnectionStrings__Nats=nats://nats:4222
Authentication__SigningKey=${JWT_SECRET:?Set JWT_SECRET}
Authentication__Issuer=NoCTF
Authentication__Audience=NoCTF.Api
Authentication__RefreshCookieSecure=true
ForwardedHeaders__KnownNetworks__0=${NOCTF_PROXY_NETWORK:?Set the trusted proxy subnet}
ForwardedHeaders__AllowedHosts__0=${NOCTF_PUBLIC_HOST:?Set NOCTF_PUBLIC_HOST}
RunnerScoring__SigningKey=${RUNNER_SCORING_SECRET:?Set RUNNER_SCORING_SECRET}
RunnerScoring__Issuer=NoCTF.Runner
RunnerScoring__Audience=NoCTF.ScoringInput
RunnerScoring__CallbackBaseUrl=http://noctf:8080
Database__AutoMigrate=true
Database__StartupTimeoutSeconds=180
Database__StartupRetryDelaySeconds=2
SeedAdmin__UserName=${SEED_ADMIN_USERNAME:-admin}
SeedAdmin__Email=${SEED_ADMIN_EMAIL:?Set SEED_ADMIN_EMAIL}
SeedAdmin__Password=${SEED_ADMIN_PASSWORD:?Set SEED_ADMIN_PASSWORD}
EmailVerification__EncryptionKey=${EMAIL_VERIFICATION_ENCRYPTION_KEY:?Set the 32-byte Base64 encryption key}
Sso__AllowInsecurePublicBaseUrl=false
Sso__AllowInsecureProviderUrls=false
Webhooks__PublicBaseUrl=${NOCTF_PUBLIC_URL:?Set NOCTF_PUBLIC_URL}
Webhooks__TimeoutSeconds=10
HumanVerification__Provider=${HUMAN_VERIFICATION_PROVIDER:-None}
HumanVerification__Cap__ServerUrl=${CAP_SERVER_URL:-}
HumanVerification__Cap__BackendServerUrl=${CAP_BACKEND_SERVER_URL:-}
HumanVerification__Cap__SiteKey=${CAP_SITE_KEY:-}
HumanVerification__Cap__Secret=${CAP_SECRET:-}
HumanVerification__Cap__ManagementApiKey=${CAP_MANAGEMENT_API_KEY:-}
HumanVerification__Turnstile__SiteKey=${TURNSTILE_SITE_KEY:-}
HumanVerification__Turnstile__Secret=${TURNSTILE_SECRET:-}
HumanVerification__Turnstile__AllowedHostnames__0=${TURNSTILE_ALLOWED_HOSTNAME:-}
HumanVerification__Validation__PublicOrigin=${NOCTF_PUBLIC_URL:?Set NOCTF_PUBLIC_URL}
HumanVerification__Validation__StageTimeoutSeconds=3
Storage__Provider=Local
Storage__LocalRoot=/app/uploads
Storage__PublicBaseUrl=${NOCTF_PUBLIC_URL:?Set NOCTF_PUBLIC_URL}
Runner__Provider=Docker
Runner__Pool=default
Runner__Id=docker-runner-1
Runner__Heartbeat__IntervalSeconds=5
Runner__Heartbeat__TtlSeconds=15
Runner__Cleanup__GracefulStopSeconds=2
Runner__Cleanup__ForceDeleteTimeoutSeconds=8
Runner__Cleanup__NetworkCleanupTimeoutSeconds=5
Runner__Cleanup__VerificationTimeoutSeconds=3
Runtime__Provider=Docker
Runtime__RunnerPool=default
Runtime__Docker__Endpoint=unix:///var/run/docker.sock
Runtime__Docker__Network=${COMPOSE_PROJECT_NAME:-noctf}-network
Runtime__Docker__PublicHost=${DOCKER_PUBLISHED_HOST:?Set the public challenge connection host}
Runtime__Docker__CallbackContainerLabelValue=scoring-callback-gateway
Runtime__Docker__ProxyContainerLabelKey=noctf.io/runtime-proxy-gateway
Runtime__Docker__ProxyContainerLabelValue=true
RuntimeProxy__MaximumConnectionsPerRuntime=32
RuntimeProxy__MaximumConnectionMinutes=30
RuntimeProxy__ConnectTimeoutSeconds=10
RuntimeProxy__DefaultCaptureLimitBytes=268435456
RuntimeProxy__MaximumCaptureLimitBytes=4294967296
DOCKER_CONFIG=/app/docker-config
Observability__Enabled=false
OTEL_SDK_DISABLED=true
