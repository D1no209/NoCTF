# Copy to .env in the installation directory. Do not commit the populated file.
COMPOSE_PROJECT_NAME=noctf
# Exact image produced by GitHub CI, preferably repository@sha256:... (not a local build).
NOCTF_PLATFORM_IMAGE=
POSTGRES_IMAGE=postgres:16.14@sha256:95206741a5b214807675e14165369d05b93a9cf692223b616d07cca227e74b0b
REDIS_IMAGE=redis:7.4.9@sha256:a8f08480e1f88f2647fed492d1178c06abb0d0c1fbf02c682a61e2f483fb3954
NATS_IMAGE=docker.m.daocloud.io/library/nats:2.12.2-alpine@sha256:2d5fce3229ae5741f4ef9225aff95dc4dc036455931eaf77a3eec33fddaa192d
REGISTRY_IMAGE=registry:3.0.0@sha256:6c5666b861f3505b116bb9aa9b25175e71210414bd010d92035ff64018f9457e

POSTGRES_DB=noctf
POSTGRES_USER=noctf
# Use generated hex secrets. Keep existing values when upgrading an installed platform.
POSTGRES_PASSWORD=
JWT_SECRET=
RUNNER_SCORING_SECRET=
EMAIL_VERIFICATION_ENCRYPTION_KEY=
HUMAN_VERIFICATION_PROVIDER=None
# Cap mode: point at an independently operated official Cap Standalone instance.
CAP_SERVER_URL=
CAP_BACKEND_SERVER_URL=
CAP_SITE_KEY=
CAP_SECRET=
# Dedicated Cap API key used only by the NoCTF administrator UI to update
# difficulty and challenge count. Do not use Cap's ADMIN_KEY here.
CAP_MANAGEMENT_API_KEY=
# Turnstile mode: create separate widgets/keys for each deployment.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
TURNSTILE_ALLOWED_HOSTNAME=
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
REGISTRY_HTTP_SECRET=

# Operations supplies DNS/TLS/reverse proxy. Use its real host names and proxy subnet.
NOCTF_PUBLIC_HOST=
NOCTF_PUBLIC_URL=
NOCTF_PROXY_NETWORK=
DOCKER_PUBLISHED_HOST=

# Optional RustFS and bounded cache. Keep existing S3 credentials when updating.
RUSTFS_IMAGE=rustfs/rustfs:1.0.0@sha256:8cc9801755448b71a786705ce76692c77e14936cccd87cf2fc31842e58f4d1ff
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=noctf
S3_PUBLIC_URL=
REDIS_MAXMEMORY=512mb
REDIS_MEMORY_LIMIT=1g
NOCTF_SHARED_ROOT=/opt/noctf/shared/observability
