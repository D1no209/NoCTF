bindAddr = "0.0.0.0"
bindPort = 60999
proxyBindAddr = "0.0.0.0"
# Reserve 36632 and the control ports 60998/60999. Re-inventory before use elsewhere.
allowPorts = [{ start = 32768, end = 36631 }, { start = 36633, end = 60997 }]
maxPortsPerClient = 8
auth.token = "{{ .Envs.NOCTF_FRP_TOKEN }}"
transport.tls.force = true
transport.tls.certFile = "/config/server.crt"
transport.tls.keyFile = "/config/server.key"
transport.tls.trustedCaFile = "/config/ca.crt"
