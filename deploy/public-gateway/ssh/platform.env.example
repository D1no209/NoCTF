# Loaded on the combined host; for separate roles, capabilities must also match the API configuration.
# Does not enable the database policy automatically. Authorize via the existing platform management page.
PublicGateway__Transport=SharedSsh
PublicGateway__ConnectorId=${NOCTF_GATEWAY_CONNECTOR_ID:?Set connector identity}
PublicGateway__RunnerId=${NOCTF_GATEWAY_RUNNER_ID:?Must match Runner__Id}
PublicGateway__ApprovedOrigins__0=${NOCTF_GATEWAY_PUBLIC_ORIGIN:?Set approved HTTPS platform origin}
PublicGateway__NamespaceIsolationAvailable=${NOCTF_GATEWAY_SAFETY_APPROVED:-false}
PublicGateway__FirstPort=${NOCTF_GATEWAY_FIRST_PORT:-40000}
PublicGateway__LastPort=${NOCTF_GATEWAY_LAST_PORT:-40255}
PublicGateway__MaximumPorts=${NOCTF_GATEWAY_MAXIMUM_PORTS:-8}
PublicGateway__ServerHost=${NOCTF_GATEWAY_SERVER_HOST:?Set paired jump host}
PublicGateway__ServerPort=${NOCTF_GATEWAY_CONTROL_PORT:-60999}
PublicGateway__ClientImage=${NOCTF_SSH_CLIENT_IMAGE:?Use CI digest}
PublicGateway__RelayImage=${NOCTF_GATEWAY_RELAY_IMAGE:?Use CI digest}
PublicGateway__PrivateKeyFile=/app/public-gateway-keys/key
PublicGateway__KnownHostsFile=/app/public-gateway-keys/known_hosts
PublicGateway__LocalStateDirectory=/app/public-gateway-state
PublicGateway__HostStateDirectory=${NOCTF_GATEWAY_STATE_DIRECTORY:?Must match the host bind directory}
