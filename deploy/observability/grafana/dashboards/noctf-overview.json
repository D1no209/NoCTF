{
  "annotations": { "list": [] },
  "editable": false,
  "graphTooltip": 1,
  "panels": [
    {
      "type": "timeseries", "title": "API 请求吞吐", "id": 1,
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 },
      "targets": [{ "expr": "sum by (endpoint) (rate(noctf_api_requests_total{role=\"api\"}[5m]))", "legendFormat": "{{endpoint}}" }]
    },
    {
      "type": "timeseries", "title": "API P50 / P95 / P99", "id": 2,
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 0 },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum by (le) (rate(noctf_api_request_duration_seconds_bucket{role=\"api\"}[5m])))", "legendFormat": "P50" },
        { "expr": "histogram_quantile(0.95, sum by (le) (rate(noctf_api_request_duration_seconds_bucket{role=\"api\"}[5m])))", "legendFormat": "P95" },
        { "expr": "histogram_quantile(0.99, sum by (le) (rate(noctf_api_request_duration_seconds_bucket{role=\"api\"}[5m])))", "legendFormat": "P99" }
      ]
    },
    {
      "type": "timeseries", "title": "API 错误率 / 限流", "id": 3,
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 0 },
      "targets": [
        { "expr": "sum(rate(noctf_api_requests_total{role=\"api\",outcome=\"server_error\"}[5m])) / clamp_min(sum(rate(noctf_api_requests_total{role=\"api\"}[5m])), 1)", "legendFormat": "5xx ratio" },
        { "expr": "sum(rate(noctf_api_rate_limit_rejections_total{role=\"api\"}[5m]))", "legendFormat": "rate limited/s" }
      ]
    },
    {
      "type": "timeseries", "title": "Flag / Fix / Runtime 操作", "id": 4,
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 8 },
      "targets": [{ "expr": "sum by (endpoint, outcome) (rate(noctf_runtime_operations_total{role=\"api\"}[5m]))", "legendFormat": "{{endpoint}} {{outcome}}" }]
    },
    {
      "type": "timeseries", "title": "NATS JetStream 关键消费者", "id": 5,
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 8 },
      "targets": [
        { "expr": "sum(max by (stream_name, consumer_name) (jetstream_consumer_num_pending{is_consumer_leader=\"true\",stream_name=~\"NOCTF_CONTROL|NOCTF_GAMEPLAY\"})) or vector(0)", "legendFormat": "pending" },
        { "expr": "sum(max by (stream_name, consumer_name) (jetstream_consumer_num_ack_pending{is_consumer_leader=\"true\",stream_name=~\"NOCTF_CONTROL|NOCTF_GAMEPLAY\"})) or vector(0)", "legendFormat": "ack pending" },
        { "expr": "sum(max by (stream_name, consumer_name) (jetstream_consumer_num_redelivered{is_consumer_leader=\"true\",stream_name=~\"NOCTF_CONTROL|NOCTF_GAMEPLAY\"})) or vector(0)", "legendFormat": "redelivered" },
        { "expr": "sum by (stream_name) (max by (stream_name, server_name) (jetstream_stream_total_messages{is_stream_leader=\"true\"}))", "legendFormat": "{{stream_name}} messages" },
        { "expr": "sum(max by (server_name) (jetstream_server_total_message_bytes)) / clamp_min(sum(max by (server_name) (jetstream_server_max_storage)), 1)", "legendFormat": "storage ratio" }
      ]
    },
    {
      "type": "timeseries", "title": "Wolverine 事务消息与吞吐", "id": 6,
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 8 },
      "targets": [
        { "expr": "sum(wolverine_outbox_count_Messages)", "legendFormat": "outbox" },
        { "expr": "sum(wolverine_inbox_count_Messages)", "legendFormat": "inbox" },
        { "expr": "sum(rate(wolverine_messages_sent_Messages_total{role=\"worker\"}[5m]))", "legendFormat": "sent/s" },
        { "expr": "sum(rate(wolverine_messages_succeeded_Messages_total{role=\"worker\"}[5m]))", "legendFormat": "completed/s" }
      ]
    },
    {
      "type": "timeseries", "title": "Wolverine Handler P95", "id": 7,
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 16 },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum by (le) (rate(wolverine_execution_time_Milliseconds_bucket{role=\"worker\"}[5m])))", "legendFormat": "execution P95(ms)" },
        { "expr": "histogram_quantile(0.95, sum by (le) (rate(wolverine_effective_time_Milliseconds_bucket{role=\"worker\"}[5m])))", "legendFormat": "end-to-end P95(ms)" }
      ]
    },
    {
      "type": "timeseries", "title": "排行榜投影", "id": 8,
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 16 },
      "targets": [
        { "expr": "sum(rate(noctf_leaderboard_merge_dispatches_total{role=\"worker\",outcome=\"failure\"}[5m])) or vector(0)", "legendFormat": "merge dispatch failures/s" },
        { "expr": "sum(rate(noctf_leaderboard_cache_miss_rebuilds_total{role=\"api\",outcome=\"failure\"}[5m])) or vector(0)", "legendFormat": "cache rebuild failures/s" },
        { "expr": "histogram_quantile(0.95, sum by (le) (rate(noctf_leaderboard_projection_duration_seconds_bucket{role=\"worker\"}[5m])))", "legendFormat": "projection P95(s)" },
        { "expr": "sum(rate(noctf_leaderboard_publish_failures_total{role=\"worker\"}[5m])) or vector(0)", "legendFormat": "publish failures/s" },
        { "expr": "sum(rate(noctf_signalr_publishes_total{role=\"api\",endpoint=\"leaderboard\",outcome=\"failure\"}[5m])) or vector(0)", "legendFormat": "SignalR failures/s" }
      ]
    },
    {
      "type": "timeseries", "title": "Runner 在线与容量", "id": 9,
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 16 },
      "targets": [
        { "expr": "sum by (pool) (noctf_runner_online{role=\"runner\"})", "legendFormat": "{{pool}} online" },
        { "expr": "sum by (pool, resource) (noctf_runner_capacity_available{role=\"runner\"}) / clamp_min(sum by (pool, resource) (noctf_runner_capacity_total{role=\"runner\"}), 1)", "legendFormat": "{{pool}} {{resource}} available" }
      ]
    },
    {
      "type": "timeseries", "title": "Runtime 等待 / Runner Claim", "id": 10,
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 24 },
      "targets": [
        { "expr": "noctf_runtime_waiting{role=\"worker\"}", "legendFormat": "waiting" },
        { "expr": "noctf_runtime_waiting_oldest_age_seconds{role=\"worker\"}", "legendFormat": "oldest(s)" },
        { "expr": "sum by (pool, outcome) (rate(noctf_runner_claim_attempts_total{role=\"worker\"}[5m]))", "legendFormat": "{{pool}} {{outcome}} attempts/s" },
        { "expr": "histogram_quantile(0.95, sum by (le, pool) (rate(noctf_runner_claim_duration_seconds_bucket{role=\"worker\"}[5m])))", "legendFormat": "{{pool}} claim P95(s)" }
      ]
    },
    {
      "type": "timeseries", "title": "Redis 延迟 / 失败", "id": 11,
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 24 },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum by (le, endpoint) (rate(noctf_redis_operation_duration_seconds_bucket[5m])))", "legendFormat": "{{endpoint}} P95" },
        { "expr": "histogram_quantile(0.99, sum by (le, endpoint) (rate(noctf_redis_operation_duration_seconds_bucket[5m])))", "legendFormat": "{{endpoint}} P99" },
        { "expr": "sum by (endpoint) (rate(noctf_redis_failures_total[5m]))", "legendFormat": "{{endpoint}} failures/s" }
      ]
    },
    {
      "type": "timeseries", "title": "SignalR 连接 / 发布", "id": 12,
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 24 },
      "targets": [
        { "expr": "sum by (endpoint) (noctf_signalr_connections{role=\"api\"})", "legendFormat": "{{endpoint}} connections" },
        { "expr": "histogram_quantile(0.95, sum by (le, endpoint) (rate(noctf_signalr_publish_duration_seconds_bucket[5m])))", "legendFormat": "{{endpoint}} publish P95(s)" },
        { "expr": "sum by (endpoint, outcome) (rate(noctf_signalr_publishes_total[5m]))", "legendFormat": "{{endpoint}} {{outcome}}/s" }
      ]
    },
    {
      "type": "timeseries", "title": "PostgreSQL 连接", "id": 13,
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 32 },
      "targets": [
        { "expr": "sum by (state) (pg_stat_activity_count)", "legendFormat": "server {{state}}" },
        { "expr": "sum by (state) (db_client_connection_count)", "legendFormat": "Npgsql {{state}}" }
      ]
    },
    {
      "type": "timeseries", "title": "PostgreSQL 查询延迟 / 超时", "id": 14,
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 32 },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum by (le) (rate(db_client_operation_duration_seconds_bucket[5m])))", "legendFormat": "operation P95(s)" },
        { "expr": "histogram_quantile(0.99, sum by (le) (rate(db_client_operation_duration_seconds_bucket[5m])))", "legendFormat": "operation P99(s)" },
        { "expr": "sum(rate(db_client_connection_npgsql_timeouts_total[5m]))", "legendFormat": "pool timeouts/s" }
      ]
    },
    {
      "type": "timeseries", "title": "PostgreSQL 锁 / 事务", "id": 15,
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 32 },
      "targets": [
        { "expr": "sum by (mode) (pg_locks_count)", "legendFormat": "locks {{mode}}" },
        { "expr": "max(pg_stat_activity_max_tx_duration{state!=\"idle\"})", "legendFormat": "oldest transaction(s)" }
      ]
    }
  ],
  "refresh": "15s",
  "schemaVersion": 41,
  "tags": ["noctf", "operations"],
  "templating": { "list": [] },
  "time": { "from": "now-6h", "to": "now" },
  "timezone": "browser",
  "title": "NoCTF Operations Overview",
  "uid": "noctf-operations",
  "version": 2
}
