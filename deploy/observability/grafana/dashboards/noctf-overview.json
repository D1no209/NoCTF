{
  "annotations": { "list": [] },
  "editable": false,
  "graphTooltip": 1,
  "panels": [
    {
      "type": "timeseries", "title": "API 请求吞吐", "id": 1,
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 },
      "targets": [{ "expr": "sum by (endpoint) (rate(noctf_api_requests_total[5m]))", "legendFormat": "{{endpoint}}" }]
    },
    {
      "type": "timeseries", "title": "API P50 / P95 / P99", "id": 2,
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 0 },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum by (le) (rate(noctf_api_request_duration_seconds_bucket[5m])))", "legendFormat": "P50" },
        { "expr": "histogram_quantile(0.95, sum by (le) (rate(noctf_api_request_duration_seconds_bucket[5m])))", "legendFormat": "P95" },
        { "expr": "histogram_quantile(0.99, sum by (le) (rate(noctf_api_request_duration_seconds_bucket[5m])))", "legendFormat": "P99" }
      ]
    },
    {
      "type": "timeseries", "title": "API 错误率 / 限流", "id": 3,
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 0 },
      "targets": [
        { "expr": "sum(rate(noctf_api_requests_total{outcome=\"server_error\"}[5m])) / clamp_min(sum(rate(noctf_api_requests_total[5m])), 1)", "legendFormat": "5xx ratio" },
        { "expr": "sum(rate(noctf_api_rate_limit_rejections_total[5m]))", "legendFormat": "rate limited/s" }
      ]
    },
    {
      "type": "timeseries", "title": "Flag / Fix / Runtime 操作", "id": 4,
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 8 },
      "targets": [{ "expr": "sum by (endpoint, outcome) (rate(noctf_runtime_operations_total[5m]))", "legendFormat": "{{endpoint}} {{outcome}}" }]
    },
    {
      "type": "timeseries", "title": "Wolverine 队列积压与最老等待", "id": 5,
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 8 },
      "targets": [
        { "expr": "noctf_worker_queue_depth", "legendFormat": "{{queue}} depth" },
        { "expr": "noctf_worker_queue_oldest_age_seconds", "legendFormat": "{{queue}} oldest(s)" }
      ]
    },
    {
      "type": "timeseries", "title": "排行榜投影", "id": 6,
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 8 },
      "targets": [
        { "expr": "noctf_leaderboard_dirty_competitions", "legendFormat": "dirty" },
        { "expr": "noctf_leaderboard_dirty_oldest_age_seconds", "legendFormat": "oldest(s)" },
        { "expr": "histogram_quantile(0.95, sum by (le) (rate(noctf_leaderboard_projection_duration_seconds_bucket[5m])))", "legendFormat": "projection P95" }
      ]
    },
    {
      "type": "timeseries", "title": "Runner 等待与容量", "id": 7,
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 16 },
      "targets": [
        { "expr": "noctf_runtime_waiting", "legendFormat": "waiting" },
        { "expr": "noctf_runtime_waiting_oldest_age_seconds", "legendFormat": "oldest(s)" },
        { "expr": "noctf_runner_capacity_available_ratio", "legendFormat": "{{pool}} available" }
      ]
    },
    {
      "type": "timeseries", "title": "Redis P95 / P99", "id": 8,
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 16 },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum by (le) (rate(noctf_redis_operation_duration_seconds_bucket[5m])))", "legendFormat": "P95" },
        { "expr": "histogram_quantile(0.99, sum by (le) (rate(noctf_redis_operation_duration_seconds_bucket[5m])))", "legendFormat": "P99" }
      ]
    },
    {
      "type": "timeseries", "title": "PostgreSQL 连接", "id": 9,
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 16 },
      "targets": [{ "expr": "sum by (state) (pg_stat_activity_count)", "legendFormat": "{{state}}" }]
    }
  ],
  "refresh": "15s",
  "schemaVersion": 41,
  "tags": ["noctf", "operations"],
  "templating": { "list": [] },
  "time": { "from": "now-6h", "to": "now" },
  "timezone": "browser",
  "title": "NoCTF Operations Overview",
  "uid": "noctf-operations",
  "version": 1
}
