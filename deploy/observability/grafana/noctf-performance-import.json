        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (stream_name, consumer_name) (jetstream_consumer_num_pending{is_consumer_leader=\"true\",stream_name=~\"NOCTF_V2_.*\"})",
          "legendFormat": "{{stream_name}} / {{consumer_name}}"
        }
      ]
    },
    {
      "id": 29,
      "type": "timeseries",
      "title": "Npgsql 命令 P95 / P99",
      "description": "数据库命令执行耗时，不包括 EF Core 将全部结果行物化后的时间；不采集 SQL 文本或参数。",
      "gridPos": {
