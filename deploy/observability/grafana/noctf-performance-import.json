{
  "annotations": {
    "list": []
  },
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "NoCTF 在线",
      "description": "1 表示 Prometheus 最近一次抓取 NoCTF 成功；0 表示目标不可达。",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(up{job=\"noctf\"})"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "请求速率",
      "description": "按所选路由与统计窗口计算 REST 请求/秒。",
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(noctf_api_requests_total{request_kind=\"rest\",endpoint=~\"${route:regex}\"}[$window])) or vector(0)"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "5xx 比例",
      "description": "仅统计服务端错误；预期中的 Runtime 404 不计入 5xx。样本数见右侧。",
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.01
              },
              {
                "color": "red",
                "value": 0.02
              }
            ]
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(rate(noctf_api_requests_total{request_kind=\"rest\",outcome=\"server_error\",endpoint=~\"${route:regex}\"}[$window])) or vector(0)) / clamp_min((sum(rate(noctf_api_requests_total{request_kind=\"rest\",endpoint=~\"${route:regex}\"}[$window])) or vector(0)), 0.001)"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "接口 P95",
      "description": "服务端请求耗时的直方图估算；低样本窗口不可作为稳定结论。",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.25
              },
              {
                "color": "red",
                "value": 0.8
              }
            ]
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(noctf_api_request_duration_seconds_bucket{request_kind=\"rest\",endpoint=~\"${route:regex}\"}[$window])))"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "接口 P99",
      "description": "服务端请求耗时尾部；须结合样本数和错误率阅读。",
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(noctf_api_request_duration_seconds_bucket{request_kind=\"rest\",endpoint=~\"${route:regex}\"}[$window])))"
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "窗口样本数",
      "description": "所选路由在统计窗口内的近似请求数；样本太少时不要解读 P95/P99。",
      "gridPos": {
        "x": 20,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(noctf_api_request_duration_seconds_count{request_kind=\"rest\",endpoint=~\"${route:regex}\"}[$window])) or vector(0)"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "所选路由延迟趋势",
      "description": "选“全部”时为 REST 总体分布；选定路由后为该路由的 P50/P95/P99。单位为秒。",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(noctf_api_request_duration_seconds_bucket{request_kind=\"rest\",endpoint=~\"${route:regex}\"}[$window])))",
          "legendFormat": "P50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(noctf_api_request_duration_seconds_bucket{request_kind=\"rest\",endpoint=~\"${route:regex}\"}[$window])))",
          "legendFormat": "P95"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(noctf_api_request_duration_seconds_bucket{request_kind=\"rest\",endpoint=~\"${route:regex}\"}[$window])))",
          "legendFormat": "P99"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "最慢路由 Top 10（P95）",
      "description": "只显示所选窗口内至少 3 次请求的路由；仍须结合样本数验证尾部。",
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, (histogram_quantile(0.95, sum by (le, endpoint) (rate(noctf_api_request_duration_seconds_bucket{request_kind=\"rest\",endpoint=~\"${route:regex}\"}[$window]))) > 0) and on (endpoint) (sum by (endpoint) (increase(noctf_api_request_duration_seconds_count{request_kind=\"rest\",endpoint=~\"${route:regex}\"}[$window])) >= 3))",
          "legendFormat": "{{endpoint}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "每路由请求速率",
      "description": "最繁忙的 10 条规范路由；不使用用户 ID、Flag、令牌等高基数标签。",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, sum by (endpoint) (rate(noctf_api_requests_total{request_kind=\"rest\",endpoint=~\"${route:regex}\"}[$window])))",
          "legendFormat": "{{endpoint}}"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "4xx / 5xx 速率",
      "description": "client_error 包含预期的 404；server_error 才是 5xx。按路由与结果分开显示。",
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (endpoint, outcome) (rate(noctf_api_requests_total{request_kind=\"rest\",endpoint=~\"${route:regex}\",outcome=~\"client_error|server_error\"}[$window]))",
          "legendFormat": "{{endpoint}} · {{outcome}}"
        }
      ]
    },
    {
      "id": 11,
      "type": "table",
      "title": "路由样本数 Top 25",
      "description": "Prometheus increase 估算值。低样本路由可能没有可信的分位数。",
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(25, sum by (endpoint) (increase(noctf_api_request_duration_seconds_count{request_kind=\"rest\",endpoint=~\"${route:regex}\"}[$window])))",
          "format": "table",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Flag 处理阶段 P95",
      "description": "AdmissionLoad、AdmissionRecheck、PersistenceCommit、MessagePublish、DispatchAge、WorkerEvaluation、WorkerCompletion。没有自然提交时为空。",
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, stage) (rate(noctf_gameplay_fact_stage_duration_seconds_bucket[$window])))",
          "legendFormat": "{{stage}}"
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Flag / Break 完成耗时 P95",
      "description": "从 GameplayFact 受理到首次终态；不同 kind 单独显示，重判不计入。",
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, kind) (rate(noctf_gameplay_fact_processing_duration_seconds_bucket[$window])))",
          "legendFormat": "{{kind}}"
        }
      ]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "JetStream 待处理与重投",
      "description": "当前 NOCTF_V2 流的 pending、ack pending 和 redelivered；队列积压可解释评测可见延迟。",
      "gridPos": {
        "x": 12,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "noctf:jetstream_pending:sum",
          "legendFormat": "pending"
        },
        {
          "refId": "B",
          "expr": "noctf:jetstream_ack_pending:sum",
          "legendFormat": "ack pending"
        },
        {
          "refId": "C",
          "expr": "noctf:jetstream_redelivered:sum",
          "legendFormat": "redelivered"
        }
      ]
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Redis P99",
      "description": "NoCTF 对 Redis 操作耗时的 P99；与连接/线程池排队结合分析。",
      "gridPos": {
        "x": 0,
        "y": 36,
        "w": 6,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(noctf_redis_operation_duration_seconds_bucket[$window])))"
        }
      ]
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "Redis 错误速率",
      "description": "NoCTF Redis 操作失败/秒；与日志超时和 ThreadPool 排队对照。",
      "gridPos": {
        "x": 6,
        "y": 36,
        "w": 6,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(noctf_redis_failures_total[$window])) or vector(0)"
        }
      ]
    },
    {
      "id": 17,
      "type": "timeseries",
      "title": "Runtime 排队数",
      "description": "数据库事实中的 Queued Runtime 数量；不把等待时间与数量放在同一坐标轴。",
      "gridPos": {
        "x": 12,
        "y": 36,
        "w": 6,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "noctf:runtime_waiting:count"
        }
      ]
    },
    {
      "id": 18,
      "type": "timeseries",
      "title": "最久 Runtime 排队",
      "description": "最老 Queued Runtime 等待秒数。",
      "gridPos": {
        "x": 18,
        "y": 36,
        "w": 6,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "noctf:runtime_waiting_oldest_age:seconds"
        }
      ]
    },
    {
      "id": 19,
      "type": "timeseries",
      "title": "NoCTF CPU 核心用量",
      "description": "process_cpu_seconds_total 的增长率，单位为占用的 CPU 核数；不是宿主机 CPU 百分比。",
      "gridPos": {
        "x": 0,
        "y": 44,
        "w": 6,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(process_cpu_seconds_total{job=\"noctf\"}[$window])"
        }
      ]
    },
    {
      "id": 20,
      "type": "timeseries",
      "title": ".NET ThreadPool 排队",
      "description": "排队工作项数。上升且 CPU 不高时，优先排查阻塞、同步等待或依赖延迟。",
      "gridPos": {
        "x": 6,
        "y": 44,
        "w": 6,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "dotnet_thread_pool_queue_length_total{job=\"noctf\"}"
        }
      ]
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": ".NET GC 暂停占比",
      "description": "单位时间 GC 暂停秒数的百分比；高分配时与 CPU 和 P99 对照。",
      "gridPos": {
        "x": 12,
        "y": 44,
        "w": 6,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * rate(dotnet_gc_pause_time_seconds_total{job=\"noctf\"}[$window])"
        }
      ]
    },
    {
      "id": 22,
      "type": "timeseries",
      "title": "PostgreSQL 连接占比",
      "description": "已用连接数 / max_connections；不能直接推断单条 SQL 的耗时。",
      "gridPos": {
        "x": 18,
        "y": 44,
        "w": 6,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * noctf:postgres_connections:ratio"
        }
      ]
    },
    {
      "id": 23,
      "type": "table",
      "title": "采集目标状态",
      "description": "1 为可抓取、0 为失败；exporter 可抓取不等于依赖内部业务一定健康。",
      "gridPos": {
        "x": 0,
        "y": 52,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=~\"noctf|postgres|redis|nats|node|blackbox-exporter\"}",
          "format": "table",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 24,
      "type": "timeseries",
      "title": "宿主磁盘可用率",
      "description": "所有非临时文件系统中最低的可用比例；数据目录满盘时优先检查。",
      "gridPos": {
        "x": 12,
        "y": 52,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * noctf:disk_available:ratio"
        }
      ]
    },
    {
      "id": 25,
      "type": "timeseries",
      "title": "Wolverine Handler 执行 P95",
      "description": "按消息类型聚合，原始直方图单位为毫秒；只展示最慢的 10 类。",
      "gridPos": {
        "x": 0,
        "y": 60,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, histogram_quantile(0.95, sum by (le, message_type) (rate(wolverine_execution_time_Milliseconds_bucket[$window]))))",
          "legendFormat": "{{message_type}}"
        }
      ]
    },
    {
      "id": 26,
      "type": "timeseries",
      "title": "Wolverine 有效耗时 P95",
      "description": "按消息类型查看 Wolverine effective-time；与执行耗时对照识别排队和处理差距，单位毫秒。",
      "gridPos": {
        "x": 12,
        "y": 60,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, histogram_quantile(0.95, sum by (le, message_type) (rate(wolverine_effective_time_Milliseconds_bucket[$window]))))",
          "legendFormat": "{{message_type}}"
        }
      ]
    },
    {
      "id": 27,
      "type": "timeseries",
      "title": "Wolverine 消息吞吐",
      "description": "发送、接收与成功处理的消息/秒；重投时接收数可能高于发送数。",
      "gridPos": {
        "x": 0,
        "y": 68,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(wolverine_messages_sent_Messages_total[$window])) or vector(0)",
          "legendFormat": "sent"
        },
        {
          "refId": "B",
          "expr": "sum(rate(wolverine_messages_received_Messages_total[$window])) or vector(0)",
          "legendFormat": "received"
        },
        {
          "refId": "C",
          "expr": "sum(rate(wolverine_messages_succeeded_Messages_total[$window])) or vector(0)",
          "legendFormat": "succeeded"
        }
      ]
    },
    {
      "id": 28,
      "type": "timeseries",
      "title": "JetStream 每消费者积压",
      "description": "读取当前 NOCTF_V2 流的 consumer pending；与 Wolverine 有效耗时共同定位队列等待。",
      "gridPos": {
