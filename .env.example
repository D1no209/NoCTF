# NoCTF Environment Variables
# Copy this file to .env and fill in the values before running docker compose

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_DB=noctf
POSTGRES_USER=noctf
POSTGRES_PASSWORD=change_me_strong_password

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Must be at least 32 characters for HS256
JWT_SECRET=change_me_at_least_32_chars_long_secret_key
JWT_ISSUER=NoCTF
JWT_AUDIENCE=NoCTF

# ─── Initial Admin ───────────────────────────────────────────────────────────
# Created automatically when the database has no admin user.
SEED_ADMIN_EMAIL=admin@noctf.local
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=change_me_admin_password

# ─── MinIO (S3-compatible storage) ────────────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me_minio_password

# ─── Docker (for container management features) ───────────────────────────────
# Leave as default when running inside Docker Compose on Linux
DOCKER_HOST=unix:///var/run/docker.sock
RUNNER_PROVIDER=Docker
RUNNER_API_KEY=change_me_runner_internal_api_key
RUNNER_ALLOWED_REGISTRIES=docker.io,ghcr.io,quay.io,registry.k8s.io,localhost
RUNNER_ALLOWED_NETWORKS=deploy_default
NOCTF_PUBLIC_HOST=localhost
# Used by one-shot checker/fix containers to fetch locally stored files.
NOCTF_STORAGE_PUBLIC_BASE_URL=http://backend:8080
RUNNER_UTILITY_NETWORK=deploy_default

# ─── Kubernetes Runner (when Runner__Provider=Kubernetes) ────────────────────
K8S_PUBLIC_ENTRY=noctf.local
K8S_INGRESS_BASE_DOMAIN=challenges.noctf.local
