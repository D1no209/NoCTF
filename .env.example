# NoCTF Environment Variables
# Copy this file to .env and fill in the values before running docker compose

# The unified NoCTF.Host defaults to Api+Worker+Runner. Indexed Hosting__Roles__*
# environment variables may select any non-empty subset; changes require a restart.

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_DB=noctf
POSTGRES_USER=noctf
POSTGRES_PASSWORD=change_me_strong_password

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Must be at least 32 characters for HS256
JWT_SECRET=change_me_at_least_32_chars_long_secret_key
JWT_ISSUER=NoCTF
JWT_AUDIENCE=NoCTF
AUTHENTICATION_REFRESH_COOKIE_SECURE=true

# Used only for signed local-storage download URLs. Keep separate from JWT_SECRET.
# Must be at least 32 characters.
LOCAL_STORAGE_URL_SIGNING_KEY=change_me_local_storage_url_signing_key

# ─── Initial Admin ───────────────────────────────────────────────────────────
# Created automatically when the database has no admin user.
SEED_ADMIN_EMAIL=admin@noctf.local
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=change_me_admin_password

# ─── Email verification ──────────────────────────────────────────────────────
# Base64-encoded 32-byte key used only to encrypt the write-only SMTP password.
# Generate with: openssl rand -base64 32
# Configure verification and SMTP after startup in the administrator UI.
EMAIL_VERIFICATION_ENCRYPTION_KEY=replace_with_base64_encoded_32_byte_key

# ─── MinIO (S3-compatible storage) ────────────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me_minio_password

# ─── Docker (for container management features) ───────────────────────────────
# Leave as default when running inside Docker Compose on Linux
DOCKER_HOST=unix:///var/run/docker.sock
# Final orphan safety net; normal expiry/extension remains database-driven.
DOCKER_RUNTIME_ORPHAN_GRACE_HOURS=168
RUNNER_PROVIDER=Docker
RUNNER_API_KEY=change_me_runner_internal_api_key
RUNNER_ALLOWED_REGISTRIES=docker.io,ghcr.io,quay.io,registry.k8s.io,localhost
RUNNER_ALLOWED_NETWORKS=deploy_default
NOCTF_PUBLIC_HOST=localhost
# Absolute public platform URL used only when rendering competition/problem links in QQ messages.
NOCTF_QQBOT_PUBLIC_BASE_URL=https://ctf.example.com
# Absolute public platform URL used only when rendering competition/problem links in QQ messages.
QqBot__PublicBaseUrl=https://ctf.example.com
# Used by one-shot checker/fix containers to fetch locally stored files.
NOCTF_STORAGE_PUBLIC_BASE_URL=http://backend:8080
RUNNER_UTILITY_NETWORK=deploy_default
WORKER_CONCURRENCY=4
WORKER_LONG_RUNNING_CONCURRENCY=1
AWD_CONTAINER_REFRESH_CONCURRENCY=4
KOH_POLL_CONCURRENCY=8
RUNNER_CONCURRENCY_LIMIT=8
RUNNER_QUEUE_LIMIT=64
RUNNER_RECEIPT_MINUTES=30
RUNNER_RECEIPT_LIMIT=512
RUNNER_MAX_OPERATION_SECONDS=1800
RUNNER_MAX_REQUEST_BODY_BYTES=4194304

# ─── Kubernetes Runner (when Runner__Provider=Kubernetes) ────────────────────
K8S_PUBLIC_ENTRY=noctf.local
K8S_INGRESS_BASE_DOMAIN=challenges.noctf.local
